{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train: run current config",
      "type": "debugpy",
      "request": "launch",
      "module": "src.training.train",
      "args": ["--config", "src/training/config/exp1.yaml"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
